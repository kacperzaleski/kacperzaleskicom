---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { useTranslations } from "~/i18n";

// One 404 page for every URL, so it speaks both languages.
const en = useTranslations("en");
const de = useTranslations("de");
---

<BaseLayout title={en("404.title")} noindex>
  <section class="container" style="padding-block: 4rem">
    <div class="prose">
      <h1>{en("404.title")}</h1>
      <p>
        {en("404.text")} <a href="/">{en("404.home")}</a>.
      </p>
      <p lang="de">
        <strong>{de("404.title")}.</strong>
        {de("404.text")}{" "}
        <a href="/de" hreflang="de">
          {de("404.home")}
        </a>
        .
      </p>
    </div>
  </section>
</BaseLayout>
