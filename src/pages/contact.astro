---
import BaseLayout from "~/layouts/BaseLayout.astro";
import EmailLink from "~/components/EmailLink.astro";
import { cv } from "~/lib/cv";

const NAMES: Record<string, string> = {
  "github.com": "GitHub",
  "linkedin.com": "LinkedIn",
};
const profiles = cv.links
  .filter((l) => !l.url.includes("kacperzaleski.com"))
  .map((l) => {
    const host = new URL(l.url).hostname.replace(/^www\./, "");
    return { ...l, name: NAMES[host] ?? host };
  });
---

<BaseLayout
  title="Contact"
  description="How to get in touch with Kacper Zaleski."
>
  <section class="container contact">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lede">
      The best way to reach me is by email. I'm based in Vienna and read German,
      English and Polish.
    </p>

    <dl>
      <div>
        <dt>Email</dt>
        <dd>
          <EmailLink />
        </dd>
      </div>
      {profiles.map((l) => (
        <div>
          <dt>{l.name}</dt>
          <dd>
            <a href={l.url} rel="me">
              {l.label}
            </a>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }
  .lede {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 36rem;
    margin: 0 0 2.5rem;
  }
  dl {
    display: grid;
    gap: 1rem;
    margin: 0;
    max-width: 36rem;
  }
  dl > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: 1.1rem;
    overflow-wrap: anywhere;
  }
</style>
