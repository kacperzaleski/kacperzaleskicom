---
import LegalLayout from "~/layouts/LegalLayout.astro";
import EmailLink from "~/components/EmailLink.astro";
---

<!--
  TODO(kacper): review before relying on this. Not legal advice.
  This is a stub for a private, non-commercial personal website
  ("kleine Website" under § 25 Abs 5 MedienG), where name and place of
  residence are generally given instead of a full postal address.
  If the site becomes commercial (paid services, ads, freelance offers),
  § 5 ECG requires more, including a geographic address.
  Once checked, remove `draft` default (set draft={false}) and this comment.
-->
<LegalLayout
  title="Impressum"
  description="Impressum und Offenlegung gemäß § 25 MedienG."
>
  <h2>Offenlegung gemäß § 25 Mediengesetz</h2>
  <dl>
    <dt>Medieninhaber</dt>
    <dd>Kacper Zaleski</dd>
    <dt>Wohnort</dt>
    <dd>Wien, Österreich</dd>
    <dt>Kontakt</dt>
    <dd>
      <EmailLink />
    </dd>
  </dl>

  <h2>Grundlegende Richtung</h2>
  <p>
    Private, nicht-kommerzielle Website zur persönlichen Vorstellung: Lebenslauf
    und Übersicht über eigene Projekte.
  </p>

  <h2>Haftung für Links</h2>
  <p>
    Diese Website enthält Links zu externen Websites (z. B. GitHub, LinkedIn).
    Für deren Inhalte sind ausschließlich die jeweiligen Betreiber
    verantwortlich.
  </p>
</LegalLayout>
