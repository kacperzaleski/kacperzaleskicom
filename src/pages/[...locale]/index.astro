---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Waves from "~/components/Waves.astro";
import {
  localeStaticPaths,
  localize,
  useTranslations,
  type Lang,
} from "~/i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{t("home.eyebrow")}</p>
      <h1>Kacper Zaleski</h1>
      <p class="lede">{t("home.lede")}</p>
      <div class="actions">
        <a class="button primary" href={localize("/projects", lang)}>
          {t("home.ctaProjects")}
        </a>
        <a class="button" href={localize("/cv", lang)}>
          {t("home.ctaCv")}
        </a>
      </div>
    </div>
    <div class="hero-waves">
      <Waves lines={12} amplitude={30} height={260} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(3.5rem, 10vw, 7rem);
  }
  .lede {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--muted);
    max-width: 38rem;
    margin: 0 0 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-waves {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    height: clamp(150px, 22vw, 260px);
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }
  .hero-waves :global(svg) {
    height: 100%;
  }
</style>
