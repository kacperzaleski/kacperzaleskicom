---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { localeStaticPaths, useTranslations, type Lang } from "~/i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Featured first, then most recently pushed. (The content store doesn't keep
// the JSON's order, so sort here.)
const projects = (await getCollection("projects"))
  .map((e) => e.data)
  .sort(
    (a, b) =>
      Number(b.featured) - Number(a.featured) ||
      (b.pushedAt ?? "").localeCompare(a.pushedAt ?? ""),
  );
const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
---

<BaseLayout title={t("projects.title")} description={t("projects.description")}>
  <section class="container intro">
    <p class="eyebrow">{t("projects.title")}</p>
    <h1>{t("projects.heading")}</h1>
    <p class="lede">{t("projects.lede")}</p>
  </section>

  {featured.length > 0 && (
    <section class="container" aria-labelledby="featured-h">
      <h2 id="featured-h" class="visually-hidden">
        {t("projects.featured")}
      </h2>
      <div class="grid featured">
        {featured.map((p, i) => (
          <ProjectCard project={p} lang={lang} large eager={i === 0} />
        ))}
      </div>
    </section>
  )}

  {more.length > 0 && (
    <section class="container more" aria-labelledby="more-h">
      <h2 id="more-h">{t("projects.more")}</h2>
      <div class="grid">
        {more.map((p) => (
          <ProjectCard project={p} lang={lang} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }
  .intro h1 {
    margin-bottom: 0.5rem;
  }
  .lede {
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .grid.featured {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }
  .more {
    margin-top: 3.5rem;
  }
  .more h2 {
    font-size: 1.4rem;
    margin: 0 0 1.25rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
