---
import BaseLayout from "~/layouts/BaseLayout.astro";
import EmailLink from "~/components/EmailLink.astro";
import { cv } from "~/lib/cv";
import { localeStaticPaths, useTranslations, type Lang } from "~/i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const NAMES: Record<string, string> = {
  "github.com": "GitHub",
  "linkedin.com": "LinkedIn",
};
const profiles = cv.links
  .filter((l) => !l.url.includes("kacperzaleski.com"))
  .map((l) => {
    const host = new URL(l.url).hostname.replace(/^www\./, "");
    return { ...l, name: NAMES[host] ?? host };
  });
---

<BaseLayout title={t("contact.title")} description={t("contact.description")}>
  <section class="container contact">
    <p class="eyebrow">{t("contact.title")}</p>
    <h1>{t("contact.heading")}</h1>
    <p class="lede">{t("contact.lede")}</p>

    <dl>
      <div>
        <dt>{t("contact.email")}</dt>
        <dd>
          <EmailLink />
        </dd>
      </div>
      {profiles.map((l) => (
        <div>
          <dt>{l.name}</dt>
          <dd>
            <a href={l.url} rel="me">
              {l.label}
            </a>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }
  .lede {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 36rem;
    margin: 0 0 2.5rem;
  }
  dl {
    display: grid;
    gap: 1rem;
    margin: 0;
    max-width: 36rem;
  }
  dl > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: 1.1rem;
    overflow-wrap: anywhere;
  }
</style>
