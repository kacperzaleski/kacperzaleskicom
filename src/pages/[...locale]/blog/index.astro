---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPosts, readingTime, formatDate } from "~/lib/blog";
import { localeStaticPaths, useTranslations, type Lang } from "~/i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const posts = await getPosts();
---

<BaseLayout title={t("blog.title")} description={t("blog.description")}>
  <section class="container blog">
    <p class="eyebrow">{t("blog.title")}</p>
    <h1>{t("blog.heading")}</h1>
    <p class="lede">{t("blog.lede")}</p>

    {posts.length === 0 ? (
      <p class="empty">{t("blog.empty")}</p>
    ) : (
      <ol class="posts">
        {posts.map((post) => (
          <li lang={post.data.lang}>
            <a class="post" href={`/blog/${post.id}`}>
              <p class="meta" lang={lang}>
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date, lang)}
                </time>
                <span>
                  {readingTime(post.body)} {t("blog.minRead")}
                </span>
                {post.data.lang !== lang && (
                  <span
                    class="badge"
                    title={
                      post.data.lang === "de"
                        ? t("blog.inGerman")
                        : t("blog.inEnglish")
                    }
                  >
                    {post.data.lang.toUpperCase()}
                  </span>
                )}
                {post.data.draft && (
                  <span class="badge draft">{t("blog.draft")}</span>
                )}
              </p>
              <h2>{post.data.title}</h2>
              <p class="subtitle">{post.data.subtitle}</p>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  .blog {
    max-width: 52rem;
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }
  .lede {
    color: var(--muted);
    font-size: 1.15rem;
    margin: 0 0 2.5rem;
  }
  .empty {
    color: var(--muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .posts li {
    border-bottom: 1px solid var(--border);
  }
  .post {
    display: block;
    padding: 1.5rem 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .post h2 {
    margin: 0.35rem 0 0.4rem;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    transition: color 150ms;
  }
  .post:hover h2 {
    color: var(--accent);
    text-decoration: underline wavy var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
  }
  .subtitle {
    margin: 0;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
  }
  .badge.draft {
    background: transparent;
    border: 1px dashed var(--accent);
  }
</style>
