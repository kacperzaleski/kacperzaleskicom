---
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPosts, readingTime, formatDate, type Post } from "~/lib/blog";
import { localize, useTranslations } from "~/i18n";
import "~/styles/prose.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, subtitle, date, updated, lang, tags, cover, coverAlt, draft } =
  post.data;
const t = useTranslations(lang);
const { Content } = await render(post);
---

<BaseLayout
  title={title}
  description={subtitle}
  lang={lang}
  noindex={draft}
  langLinks={{ en: "/blog", de: "/de/blog" }}
  ogImagePath={`/og/blog-${post.id}.png`}
>
  <article class="container post">
    <a class="back" href={localize("/blog", lang)}>
      ← {t("blog.back")}
    </a>
    <header>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        <span>
          {readingTime(post.body)} {t("blog.minRead")}
        </span>
        {updated && (
          <span>
            {t("blog.updated")}{" "}
            <time datetime={updated.toISOString()}>
              {formatDate(updated, lang)}
            </time>
          </span>
        )}
        {draft && <span class="draft">{t("blog.draft")}</span>}
      </p>
      <h1>{title}</h1>
      <p class="subtitle">{subtitle}</p>
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>

    {cover && (
      <Image
        class="cover"
        src={cover}
        alt={coverAlt ?? ""}
        widths={[640, 960, 1280]}
        sizes="(min-width: 46rem) 44rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}

    <div class="prose-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 46rem;
    padding-top: clamp(2rem, 6vw, 3.5rem);
  }
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  header {
    margin-bottom: 2.5rem;
  }
  h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.2rem);
    margin: 0.5rem 0 0.75rem;
  }
  .subtitle {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--muted);
    margin: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .draft {
    padding: 0 0.5rem;
    border: 1px dashed var(--accent);
    border-radius: 999px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .tags li {
    font-size: 0.8rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
  }
  .cover {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin-bottom: 2.5rem;
  }
</style>
