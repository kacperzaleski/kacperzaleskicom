---
import "~/styles/global.css";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import { SITE } from "~/consts";
import { ogImageFor } from "~/lib/og";
import { publicPath } from "~/lib/path";
import { jsonLdScript } from "~/lib/seo";
import {
  LANGS,
  type Lang,
  isSingleLanguage,
  basePath,
  langFromPath,
  localize,
  useTranslations,
} from "~/i18n";
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Override the language (otherwise taken from the URL, /de/… = German). */
  lang?: Lang;
  /** Override where the EN | DE switch links to (e.g. blog posts). */
  langLinks?: Partial<Record<Lang, string>>;
  /** Override the social preview image path (e.g. per blog post). */
  ogImagePath?: string;
  /** schema.org structured data for this page (see src/lib/seo.ts). */
  jsonLd?: Record<string, unknown>[];
}

const path = publicPath(Astro.url.pathname);
const {
  lang = langFromPath(path),
  langLinks,
  ogImagePath,
  jsonLd,
} = Astro.props;
const t = useTranslations(lang);
const {
  title,
  description = t("site.description"),
  noindex = false,
} = Astro.props;
// Home has no title prop and uses the full keyword title.
const pageTitle = title ? `${title} · ${SITE.title}` : t("site.title");
const canonical = new URL(path, Astro.site);
const ogImage = new URL(ogImagePath ?? ogImageFor(path, lang), Astro.site);
// hreflang alternates for pages that exist in both languages.
const alternates = isSingleLanguage(basePath(path))
  ? []
  : LANGS.map((l) => ({
      lang: l,
      href: new URL(localize(path, l), Astro.site),
    }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply a stored theme choice before first paint (no flash).
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {
        // Storage blocked: fall back to the system setting.
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />
    )}
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={lang === "de" ? "de_AT" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kacper Zaleski – Blog"
      href="/blog/rss.xml"
    />
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && jsonLd.length > 0 && (
      <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("skip")}
    </a>
    <SiteHeader lang={lang} langLinks={langLinks} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
