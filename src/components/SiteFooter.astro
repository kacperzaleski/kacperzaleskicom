---
import { LEGAL_NAV, SITE } from "~/consts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row">
    <p>
      © {year} {SITE.title}
    </p>
    <nav aria-label="Legal">
      <ul>
        {LEGAL_NAV.map(({ href, label }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 4rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--muted);
  }
</style>
