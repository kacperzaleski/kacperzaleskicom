---
import WaveEdge from "~/components/WaveEdge.astro";
import KzLogo from "~/assets/brand/kz-logo.svg";
import { LEGAL_NAV, SITE } from "~/consts";
import { useTranslations, type Lang } from "~/i18n";

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <WaveEdge />
  <div class="band">
    <div class="container row">
      <p class="sign">
        <KzLogo class="logo" width={32} height={32} aria-hidden="true" />
        <span>
          © {year} {SITE.title} · {t("footer.city")}
        </span>
      </p>
      <nav aria-label={t("nav.legal")}>
        <ul>
          {LEGAL_NAV.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .sign {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .sign :global(.logo) {
    flex: none;
    border-radius: 7px;
  }
  .site-footer {
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .band {
    background: var(--surface);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem 2rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--accent);
  }
</style>
