---
import { NAV, SITE } from "~/consts";
import { publicPath } from "~/lib/path";
import { basePath, localize, useTranslations, type Lang } from "~/i18n";
import ThemeToggle from "~/components/ThemeToggle.astro";
import LanguageSwitch from "~/components/LanguageSwitch.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const path = basePath(publicPath(Astro.url.pathname));
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container bar">
    <a
      class="brand"
      href={localize("/", lang)}
      aria-label={`${SITE.title}, home`}
    >
      <svg viewBox="0 0 32 16" aria-hidden="true" focusable="false">
        <path
          d="M1 8 C 5 1, 9 1, 12 8 S 19 15, 22 8 S 28 1, 31 8"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
        ></path>
      </svg>
      <span>{SITE.title}</span>
    </a>
    <nav aria-label={t("nav.main")}>
      <ul>
        {NAV.map(({ href, key }) => (
          <li>
            <a
              href={localize(href, lang)}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <LanguageSwitch lang={lang} />
      <ThemeToggle
        labels={{ toDark: t("theme.toDark"), toLight: t("theme.toLight") }}
      />
    </div>
  </div>
</header>

<style>
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "brand nav tools";
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 1.1rem;
  }
  .brand {
    grid-area: brand;
  }
  nav {
    grid-area: nav;
    justify-self: end;
  }
  .tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  @media (max-width: 40rem) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand tools"
        "nav nav";
    }
    nav {
      justify-self: start;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }
  .brand svg {
    width: 1.75rem;
    color: var(--accent);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }
  nav a[aria-current="page"] {
    text-decoration: underline wavy var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.35em;
  }
</style>
