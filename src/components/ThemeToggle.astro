---
/**
 * Light/dark switch. Starts from the system setting; a click stores the
 * choice in localStorage ("theme") and sets data-theme on <html>.
 * The pre-paint script in BaseLayout applies a stored choice before render.
 * Hidden without JS (nothing to toggle then; the system setting applies).
 */
interface Props {
  labels: { toDark: string; toLight: string };
}
const { labels } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-to-dark={labels.toDark}
  data-to-light={labels.toLight}
  hidden
>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = matchMedia("(prefers-color-scheme: dark)");
    const current = () =>
      root.dataset.theme || (media.matches ? "dark" : "light");
    document.querySelectorAll(".theme-toggle").forEach((btn) => {
      const sync = () => {
        const dark = current() === "dark";
        btn.setAttribute(
          "aria-label",
          dark ? btn.dataset.toLight : btn.dataset.toDark,
        );
        btn.setAttribute("aria-pressed", String(dark));
      };
      btn.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage blocked (private mode): the choice just won't persist.
        }
        sync();
      });
      media.addEventListener("change", sync);
      sync();
      btn.hidden = false;
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  svg {
    grid-area: 1 / 1;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Show the icon of the theme you'd switch TO. */
  .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      display: block;
    }
    :global(:root:not([data-theme="light"])) .moon {
      display: none;
    }
  }
</style>
