---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Waves from "~/components/Waves.astro";
import { useTranslations, type Lang } from "~/i18n";

interface Props {
  project: CollectionEntry<"projects">["data"];
  /** Featured cards are larger and show the long description. */
  large?: boolean;
  /** First card on the page: load its image eagerly (LCP). */
  eager?: boolean;
  lang: Lang;
}

const { project: p, large = false, eager = false, lang } = Astro.props;
const t = useTranslations(lang);

// German texts from the override's `de:` block, English otherwise.
const de = lang === "de" ? p.de : undefined;
const title = de?.title ?? p.title;
const tagline = de?.tagline ?? p.tagline;
const body = de?.body ?? p.body;
const alt =
  de?.screenshotAlt ??
  p.screenshotAlt ??
  `${t("projects.screenshotOf")} ${title}`;

const updated = p.pushedAt
  ? new Date(p.pushedAt).toLocaleDateString(lang === "de" ? "de-AT" : "en-GB", {
      month: "short",
      year: "numeric",
    })
  : undefined;

const seed = [...p.slug].reduce((a, c) => a + c.charCodeAt(0), 0);
---

<article class:list={["card", { large }]}>
  <div class:list={["media", p.screenshotFit]}>
    {p.screenshot ? (
      <Image
        src={p.screenshot}
        alt={alt}
        widths={[480, 800, 1200, 1600]}
        sizes={
          large
            ? "(min-width: 68rem) 33rem, (min-width: 48rem) 50vw, 100vw"
            : "(min-width: 68rem) 21rem, (min-width: 48rem) 33vw, 100vw"
        }
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
      />
    ) : (
      <div class="placeholder">
        <Waves lines={7} amplitude={22} height={200} seed={seed} duration={0} />
      </div>
    )}
  </div>

  <div class="content">
    <p class="meta">
      <span class:list={["status", p.status]}>{t(`status.${p.status}`)}</span>
      {p.language && <span>{p.language}</span>}
      {updated && (
        <span>
          {t("projects.updated")} {updated}
        </span>
      )}
    </p>
    <h3>
      <a href={p.demoUrl ?? p.repoUrl} class="title-link">
        {title}
      </a>
    </h3>
    <p class="tagline">{tagline}</p>
    {large && body && (
      <div class="body">
        {body.split(/\n\s*\n/).map((para) => (
          <p>{para.replace(/\s*\n\s*/g, " ")}</p>
        ))}
      </div>
    )}
    {p.tags.length > 0 && (
      <ul class="tags" aria-label={t("projects.tags")}>
        {p.tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )}
    <p class="links">
      {p.demoUrl && (
        <a class="button primary" href={p.demoUrl}>
          {t("projects.demo")}
        </a>
      )}
      <a
        class:list={["button", { primary: !p.demoUrl && large }]}
        href={p.repoUrl}
      >
        {t("projects.code")}
      </a>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 150ms,
      transform 150ms;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .media {
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .media img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .media.cover img {
    object-fit: cover;
    object-position: top left;
  }
  .media.contain {
    background: #0b0b0b;
  }
  .media.contain img {
    object-fit: contain;
    padding: 0.5rem;
  }
  .placeholder {
    height: 100%;
    display: grid;
    align-items: center;
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 60%),
      var(--surface);
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1.35rem 1.4rem;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .status {
    font-weight: 600;
    color: var(--accent);
  }
  .status.archived {
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .large h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
  }
  .title-link {
    color: var(--text);
    text-decoration: none;
  }
  .title-link:hover {
    color: var(--accent);
  }
  .tagline {
    margin: 0;
    color: var(--muted);
  }
  .body p {
    margin: 0 0 0.6rem;
    font-size: 0.97rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
  }
  .tags li {
    font-size: 0.8rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: auto 0 0;
    padding-top: 0.6rem;
  }
  .links .button {
    font-size: 0.92rem;
    padding: 0.5rem 1rem;
  }
</style>
